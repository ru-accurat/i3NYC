    {
      "id": "about-mission",
      "type": "initiative-list",
      "data": {
        "label": "Our Mission & Strategy",
        "title": "A non-profit for Italian innovation in New York.",
        "items": [
          {
            "title": "Mission",
            "description": "To advance public understanding of innovation through educational and scientific programs for Italian innovators in the New York area."
          },
          {
            "title": "Strategy",
            "description": "Build a lasting community and keep knowledge moving between Italy and the United States."
          }
        ]
      }
